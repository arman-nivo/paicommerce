# ── Core ─────────────────────────────────────────────
DATABASE_URL=postgres://localhost:5432/paicommerce
# openssl rand -base64 32
AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Cookie domain for shared sessions across apps (".paicommerce.com" in prod, empty on localhost)
AUTH_COOKIE_DOMAIN=

# ── Public URLs ──────────────────────────────────────
NEXT_PUBLIC_WEB_URL=http://localhost:3000
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:3001
NEXT_PUBLIC_ADMIN_URL=http://localhost:3002
NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3003
# Stores are served at {slug}.{STOREFRONT_ROOT_DOMAIN}
STOREFRONT_ROOT_DOMAIN=localhost:3003

# ── Storage (local | s3) ─────────────────────────────
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# ── Optional: AI (product descriptions, SEO) ─────────
ANTHROPIC_API_KEY=

# ── Optional: platform billing gateways ──────────────
STRIPE_SECRET_KEY=
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true
