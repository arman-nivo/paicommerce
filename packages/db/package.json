{
  "name": "@pai/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts"
  },
  "scripts": {
    "db:push": "drizzle-kit push --force",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx --env-file=../../.env src/seed/index.ts",
    "db:reset": "tsx --env-file=../../.env src/seed/reset.ts && drizzle-kit push --force && tsx --env-file=../../.env src/seed/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.3",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "@types/node": "^24.0.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.0.0"
  }
}
